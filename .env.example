# Copy to .env, fill in, then load into your shell:  set -a; source .env; set +a
# Never commit real keys (.env is git-ignored).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
GOOGLE_MAPS_API_KEY=          # enable: Routes API, Roads API, Places API (New)
ROUTE_TRAVEL_MODE=TWO_WHEELER # or DRIVE (cheaper; highways avoided)
DB_PATH=motorcycle_ai.db
